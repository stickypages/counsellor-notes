{
  "name": "counsellor-notes",
  "version": "1.0.1",
  "description": "Secure private session notes for counsellors",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist": "npm run generate:icons && vite build && electron-builder --publish never",
    "dist:mac": "npm run generate:icons && vite build && electron-builder --mac --publish never",
    "dist:win": "npm run generate:icons && vite build && electron-builder --win --publish never",
    "release": "npm run generate:icons && vite build && electron-builder --publish always",
    "release:mac": "npm run generate:icons && vite build && electron-builder --mac --publish always",
    "release:win": "npm run generate:icons && vite build && electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stickypages/counsellor-notes.git"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.3.0",
    "@tiptap/pm": "^2.3.0",
    "@tiptap/react": "^2.3.0",
    "@tiptap/starter-kit": "^2.3.0",
    "electron-updater": "^6.1.8",
    "sql.js": "^1.12.0",
    "lucide-react": "^0.363.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.38",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.counsellor.notes",
    "productName": "Counsellor Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "stickypages",
      "repo": "counsellor-notes",
      "releaseType": "release"
    }
  }
}
